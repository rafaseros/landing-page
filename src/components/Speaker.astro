---
import { talks, interests } from '../data/talks';
---

<section id="speaker" class="py-24 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-16 animate-on-scroll fade-in-up">
      <p class="text-xs font-bold tracking-widest text-[var(--color-primary-container)] uppercase mb-3">
        SPEAKER & MENTORÍA
      </p>
      <h2 class="font-[var(--font-heading)] text-4xl sm:text-5xl font-bold text-[var(--color-on-surface)]">
        Speaker & Mentoría
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">

      <!-- Talk cards -->
      <div class="animate-on-scroll fade-in-left">
        <h3 class="font-[var(--font-heading)] text-xl font-bold text-[var(--color-on-surface)] mb-8">
          Charlas realizadas
        </h3>

        <div class="space-y-6">
          {talks.map((talk, idx) => (
            <div class={`talk-card p-8 rounded-r-lg group stagger-${idx + 1}`}>
              <div class="flex items-baseline gap-4 mb-3">
                <span class="text-[var(--color-primary-container)] font-[var(--font-heading)] font-bold text-lg">
                  {talk.year}
                </span>
                <span class="text-[var(--color-on-surface-variant)] text-sm font-medium">
                  {talk.event}
                </span>
              </div>

              <h4 class="font-[var(--font-heading)] text-xl font-bold text-[var(--color-on-surface)] mb-3 group-hover:text-[var(--color-primary)] transition-colors">
                {talk.title}
              </h4>

              <p class="text-[var(--color-on-surface-variant)] text-sm leading-relaxed mb-4">
                {talk.description}
              </p>

              <div class="flex flex-wrap gap-2">
                {talk.topics.map((topic) => (
                  <span class="px-3 py-1 bg-[var(--color-surface-container-high)] rounded-full text-xs font-bold text-[var(--color-tertiary)]">
                    {topic}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>

        <!-- CTA -->
        <div class="mt-8 p-5 glass-card rounded-xl border border-[var(--color-primary-container)]/20">
          <p class="text-sm text-[var(--color-on-surface-variant)]">
            ¿Interesado en que participe como speaker en tu evento?{' '}
            <a href="#contacto" class="text-[var(--color-primary-container)] hover:brightness-110 font-bold transition-all">
              Contáctame
            </a>
          </p>
        </div>
      </div>

      <!-- Interests -->
      <div class="animate-on-scroll fade-in-right">
        <h3 class="font-[var(--font-heading)] text-xl font-bold text-[var(--color-on-surface)] mb-8">
          Áreas de interés
        </h3>

        <p class="text-[var(--color-on-surface-variant)] text-sm leading-relaxed mb-8">
          Temas sobre los que me apasiona aprender, investigar y compartir con la comunidad:
        </p>

        <div class="flex flex-wrap gap-3">
          {interests.map((interest) => (
            <span class="px-4 py-2 bg-[var(--color-surface-container-high)] rounded-full text-sm font-bold text-[var(--color-tertiary)] border border-[var(--color-outline-variant)]/30 hover:border-[var(--color-primary-container)]/40 transition-colors">
              {interest}
            </span>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
