---
import { navLinks } from '../data/nav-links';
---

<nav class="fixed top-0 w-full z-50 bg-[var(--color-surface-container-lowest)]/70 backdrop-blur-xl">
  <div class="flex justify-between items-center max-w-7xl mx-auto px-8 h-20">
    <!-- Logo -->
    <a href="/" class="text-xl font-black tracking-tighter font-heading uppercase text-[var(--color-on-surface)]">
      RAFAEL GALLEGOS
    </a>

    <!-- Nav Links - Desktop -->
    <div class="hidden md:flex items-center gap-8 font-heading font-bold tracking-tight">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link text-sm text-[var(--color-on-surface-variant)] hover:text-[var(--color-on-surface)] transition-colors relative pb-1"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-4">
      <!-- Theme Toggle -->
      <button
        id="theme-toggle"
        onclick="toggleTheme()"
        class="p-2 rounded-lg bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
        aria-label="Cambiar tema"
      >
        <svg
          class="w-5 h-5 hidden dark:block text-[var(--color-on-surface)]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
            fill-rule="evenodd"
            clip-rule="evenodd"></path>
        </svg>
        <svg
          class="w-5 h-5 block dark:hidden text-[var(--color-on-surface)]"
          fill="currentColor"
          viewBox="0 0 20 20"
        >
          <path
            d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"
          ></path>
        </svg>
      </button>

      <!-- Ver CV Button -->
      <a
        href="/cv"
        class="hidden md:inline-flex bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] px-6 py-2 rounded-md font-bold transition-all hover:brightness-110 font-heading tracking-tight text-sm"
      >
        Ver CV
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-button"
        class="md:hidden p-2 rounded-lg bg-black/5 dark:bg-white/5 border border-black/10 dark:border-white/10 hover:bg-black/10 dark:hover:bg-white/10 transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-5 h-5 text-[var(--color-on-surface)]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Unattached bottom line spanning 80% width -->
  <div class="w-[80%] mx-auto h-px bg-[var(--color-surface-bright)] opacity-30"></div>
</nav>

<!-- Backdrop -->
<div id="mobile-menu-backdrop" class="hidden fixed inset-0 bg-black/60 z-40 md:hidden"></div>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="hidden md:hidden fixed top-20 left-0 right-0 z-50 bg-[var(--color-surface-container-lowest)]/95 backdrop-blur-xl border-b border-[var(--color-outline-variant)] shadow-lg"
>
  <div class="flex flex-col gap-1 p-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="nav-link font-heading font-bold tracking-tight text-sm text-[var(--color-on-surface-variant)] hover:text-[var(--color-on-surface)] py-3 px-4 rounded-lg hover:bg-white/5 transition-colors"
      >
        {link.label}
      </a>
    ))}
    <div class="h-px bg-[var(--color-surface-bright)] opacity-30 my-2"></div>
    <a
      href="/cv"
      class="block py-3 px-4 bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] rounded-md font-bold font-heading tracking-tight text-sm text-center transition-all hover:brightness-110"
    >
      Ver CV
    </a>
  </div>
</div>

<style>
  .nav-link.active {
    color: var(--color-primary-container);
    border-bottom: 2px solid var(--color-primary-container);
  }
</style>
