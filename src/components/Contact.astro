---
---

<section id="contacto" class="py-20 bg-(--bg-secondary)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Encabezado -->
    <div class="text-center mb-16">
      <p class="font-body text-accent font-medium mb-2">¿Tienes un proyecto?</p>
      <h2
        class="font-heading text-3xl sm:text-4xl font-bold text-(--text-primary)"
      >
        Contáctame
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Mensaje -->
      <div class="animate-on-scroll fade-in-left">
        <h3 class="font-heading text-2xl font-bold text-(--text-primary) mb-4">
          Trabajemos juntos
        </h3>

        <p
          class="font-body text-(--text-secondary) text-lg mb-6 leading-relaxed"
        >
          Estoy abierto a nuevas oportunidades, colaboraciones y proyectos
          interesantes. Si tienes una idea, necesitas consultoría técnica o
          simplemente quieres conectar, no dudes en escribirme.
        </p>

        <p class="font-body text-(--text-secondary) mb-8">
          Actualmente me interesa especialmente:
        </p>

        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3 font-body text-(--text-primary)">
            <span class="w-2 h-2 bg-accent rounded-full"></span>
            Consultoría en transformación digital
          </li>
          <li class="flex items-center gap-3 font-body text-(--text-primary)">
            <span class="w-2 h-2 bg-accent rounded-full"></span>
            Proyectos de desarrollo con Laravel
          </li>
          <li class="flex items-center gap-3 font-body text-(--text-primary)">
            <span class="w-2 h-2 bg-accent rounded-full"></span>
            Implementación de soluciones en salud
          </li>
          <li class="flex items-center gap-3 font-body text-(--text-primary)">
            <span class="w-2 h-2 bg-accent rounded-full"></span>
            Charlas y workshops sobre tecnología
          </li>
        </ul>

        <div class="p-4 bg-accent/10 border border-accent/20 rounded-lg">
          <p class="font-body text-sm text-(--text-primary)">
            <span class="font-semibold">Ubicación:</span> Santa Cruz de la Sierra,
            Bolivia
          </p>
          <p class="font-body text-sm text-(--text-secondary) mt-1">
            Disponible para trabajo remoto y proyectos internacionales.
          </p>
        </div>
      </div>

      <!-- Contact Methods -->
      <div class="animate-on-scroll fade-in-right">
        <h3 class="font-heading text-xl font-bold text-(--text-primary) mb-6">
          Formas de contacto
        </h3>

        <div class="space-y-4">
          <!-- Email -->
          <a
            href="mailto:devrafaseros@gmail.com?subject=Contacto%20desde%20devrafaseros.com"
            class="flex items-center gap-4 p-5 bg-(--bg-primary) rounded-xl border border-(--border) hover:border-accent transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group"
          >
            <div class="w-12 h-12 flex items-center justify-center bg-(--bg-secondary) text-(--text-secondary) rounded-lg group-hover:bg-accent group-hover:text-white transition-colors shrink-0">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            </div>
            <div class="min-w-0">
              <p class="font-body text-sm text-(--text-secondary)">Email</p>
              <p class="font-body font-medium text-(--text-primary) group-hover:text-accent transition-colors truncate">devrafaseros@gmail.com</p>
            </div>
            <svg class="w-5 h-5 ml-auto text-(--text-secondary) group-hover:text-accent transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/59179838144?text=Hola%20Rafael%2C%20te%20contacto%20desde%20tu%20web%20devrafaseros.com"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-5 bg-(--bg-primary) rounded-xl border border-(--border) hover:border-green-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group"
          >
            <div class="w-12 h-12 flex items-center justify-center bg-(--bg-secondary) text-(--text-secondary) rounded-lg group-hover:bg-green-500 group-hover:text-white transition-colors shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </div>
            <div class="min-w-0">
              <p class="font-body text-sm text-(--text-secondary)">WhatsApp</p>
              <p class="font-body font-medium text-(--text-primary) group-hover:text-green-500 transition-colors">+591 79838144</p>
            </div>
            <svg class="w-5 h-5 ml-auto text-(--text-secondary) group-hover:text-green-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- LinkedIn -->
          <a
            href="https://www.linkedin.com/in/devrafaseros/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-5 bg-(--bg-primary) rounded-xl border border-(--border) hover:border-blue-500 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group"
          >
            <div class="w-12 h-12 flex items-center justify-center bg-(--bg-secondary) text-(--text-secondary) rounded-lg group-hover:bg-blue-500 group-hover:text-white transition-colors shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </div>
            <div class="min-w-0">
              <p class="font-body text-sm text-(--text-secondary)">LinkedIn</p>
              <p class="font-body font-medium text-(--text-primary) group-hover:text-blue-500 transition-colors">linkedin.com/in/devrafaseros</p>
            </div>
            <svg class="w-5 h-5 ml-auto text-(--text-secondary) group-hover:text-blue-500 transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- GitHub -->
          <a
            href="https://github.com/rafaseros"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 p-5 bg-(--bg-primary) rounded-xl border border-(--border) hover:border-accent transition-all duration-300 hover:-translate-y-1 hover:shadow-lg group"
          >
            <div class="w-12 h-12 flex items-center justify-center bg-(--bg-secondary) text-(--text-secondary) rounded-lg group-hover:bg-(--text-primary) group-hover:text-(--bg-primary) transition-colors shrink-0">
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
            </div>
            <div class="min-w-0">
              <p class="font-body text-sm text-(--text-secondary)">GitHub</p>
              <p class="font-body font-medium text-(--text-primary) group-hover:text-accent transition-colors">github.com/rafaseros</p>
            </div>
            <svg class="w-5 h-5 ml-auto text-(--text-secondary) group-hover:text-accent transition-colors shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
