---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section id="contacto" class="py-24 bg-[var(--color-surface-container-low)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-16 animate-on-scroll fade-in-up">
      <p class="text-xs font-bold tracking-widest text-[var(--color-primary-container)] uppercase mb-3">
        CONECTEMOS
      </p>
      <h2 class="font-[var(--font-heading)] text-4xl sm:text-5xl font-bold text-[var(--color-on-surface)]">
        Contacto
      </h2>
      <p class="text-[var(--color-on-surface-variant)] mt-4 max-w-lg mx-auto leading-relaxed">
        Estoy abierto a nuevas oportunidades, colaboraciones y proyectos interesantes.
        Si tenés una idea o necesitás consultoría técnica, escribime.
      </p>
    </div>

    <!-- Form -->
    <div class="max-w-2xl mx-auto animate-on-scroll fade-in-up">
      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="space-y-6"
      >
        <!-- Web3Forms access key -->
        <input type="hidden" name="access_key" value={web3formsKey} />
        <input type="hidden" name="subject" value="Contacto desde devrafaseros.com" />
        <input type="hidden" name="redirect" value="false" />
        <!-- Honeypot anti-spam -->
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

        <!-- Name + Email row -->
        <div class="grid sm:grid-cols-2 gap-4">
          <div>
            <label for="contact-name" class="block text-xs font-bold tracking-widest text-[var(--color-on-surface-variant)] uppercase mb-2">
              Nombre
            </label>
            <input
              id="contact-name"
              type="text"
              name="name"
              required
              placeholder="Tu nombre"
              class="w-full bg-[var(--color-surface-container-lowest)] border border-[var(--color-surface-bright)]/30 text-[var(--color-on-surface)] rounded-lg input-glow px-4 py-3 text-sm placeholder:text-slate-600 outline-none transition-all"
            />
          </div>
          <div>
            <label for="contact-email" class="block text-xs font-bold tracking-widest text-[var(--color-on-surface-variant)] uppercase mb-2">
              Email
            </label>
            <input
              id="contact-email"
              type="email"
              name="email"
              required
              placeholder="tu@email.com"
              class="w-full bg-[var(--color-surface-container-lowest)] border border-[var(--color-surface-bright)]/30 text-[var(--color-on-surface)] rounded-lg input-glow px-4 py-3 text-sm placeholder:text-slate-600 outline-none transition-all"
            />
          </div>
        </div>

        <!-- Message -->
        <div>
          <label for="contact-message" class="block text-xs font-bold tracking-widest text-[var(--color-on-surface-variant)] uppercase mb-2">
            Mensaje
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            rows="5"
            placeholder="Contame sobre tu proyecto o consulta..."
            class="w-full bg-[var(--color-surface-container-lowest)] border border-[var(--color-surface-bright)]/30 text-[var(--color-on-surface)] rounded-lg input-glow px-4 py-3 text-sm placeholder:text-slate-600 outline-none transition-all resize-none"
          ></textarea>
        </div>

        <!-- Submit -->
        <div class="flex justify-center">
          <button
            type="submit"
            class="bg-[var(--color-primary-container)] hover:brightness-110 text-[var(--color-on-primary-container)] font-bold px-12 py-4 rounded-lg transition-all shadow-lg shadow-red-900/20 font-[var(--font-heading)] tracking-wide"
          >
            Enviar mensaje
          </button>
        </div>
      </form>

      <!-- Location note -->
      <div class="mt-10 pt-8 border-t border-[var(--color-outline-variant)]/20 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-[var(--color-on-surface-variant)]">
        <span>Santa Cruz de la Sierra, Bolivia</span>
        <span>Disponible para trabajo remoto e internacional</span>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement;
  const originalBtnText = submitBtn?.innerHTML || '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'Enviando...';
    }

    try {
      const formData = new FormData(form);
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });

      const result = await response.json();

      if (result.success) {
        form.reset();
        showFormMessage('¡Mensaje enviado! Te responderé lo antes posible.', 'success');
      } else {
        showFormMessage('Hubo un error al enviar. Intentá de nuevo.', 'error');
      }
    } catch (error) {
      showFormMessage('Error de conexión. Intentá de nuevo más tarde.', 'error');
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnText;
      }
    }
  });

  function showFormMessage(message: string, type: 'success' | 'error') {
    const existing = document.getElementById('form-message');
    if (existing) existing.remove();

    const div = document.createElement('div');
    div.id = 'form-message';
    div.className = type === 'success'
      ? 'mt-4 p-4 rounded-lg bg-green-500/10 border border-green-500/20 text-green-600 dark:text-green-400 text-sm text-center'
      : 'mt-4 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-600 dark:text-red-400 text-sm text-center';
    div.textContent = message;

    form.insertAdjacentElement('afterend', div);

    setTimeout(() => div.remove(), 5000);
  }
</script>
