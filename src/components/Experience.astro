---
import { experiences } from '../data/experience';
---

<section id="experiencia" class="py-32 px-8">

  <!-- Section header -->
  <div class="text-center space-y-4 mb-16">
    <span class="text-sm font-bold uppercase tracking-[0.2em] text-[var(--color-primary-container)]">
      El Recorrido
    </span>
    <h2 class="text-4xl font-[var(--font-heading)] font-bold tracking-tight">
      Línea de Experiencia
    </h2>
  </div>

  <!-- Timeline -->
  <div class="relative max-w-4xl mx-auto">

    <!-- Vertical center line -->
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 timeline-line transform md:-translate-x-1/2 bg-[var(--color-outline-variant)]/30"></div>

    <div class="space-y-12">
      {experiences.map((exp, index) => {
        const isEven = index % 2 === 0;
        return (
          <div class={`relative flex items-start gap-8 animate-on-scroll ${isEven ? 'fade-in-left' : 'fade-in-right'}`}>

            <!-- MOBILE: left-pinned dot -->
            <!-- DESKTOP: center dot -->
            <div class={`
              absolute left-4 md:left-1/2 top-6
              transform -translate-x-1/2
              z-10
              ${exp.current
                ? 'w-4 h-4 bg-[var(--color-primary-container)] rounded-full pulse-dot'
                : 'w-4 h-4 bg-slate-700 rounded-full border-2 border-[var(--color-primary-container)]/50'
              }
            `}></div>

            {/* Desktop: even → date left + card right */}
            {/* Desktop: odd  → card left + date right */}

            {isEven ? (
              <>
                {/* Date — left side (desktop) / hidden on mobile */}
                <div class="hidden md:flex md:w-1/2 md:justify-end md:pr-12 pt-4">
                  <span class="text-[var(--color-on-surface-variant)] font-[var(--font-heading)] font-bold text-xl text-right">
                    {exp.period}
                  </span>
                </div>

                {/* Card — right side (desktop) / full width indented (mobile) */}
                <div class="ml-10 md:ml-0 md:w-1/2 md:pl-12">
                  {/* Period visible on mobile */}
                  <p class="md:hidden text-[var(--color-on-surface-variant)] font-bold text-sm mb-2">{exp.period}</p>
                  <div class="bg-[var(--color-surface-container)] ghost-border p-6 rounded-xl hover:border-[var(--color-primary-container)]/30 transition-all duration-300">
                    {exp.current && (
                      <span class="inline-block mb-2 px-2 py-0.5 text-xs font-bold uppercase tracking-wider bg-[var(--color-primary-container)]/10 text-[var(--color-primary-container)] rounded-full">
                        Actual
                      </span>
                    )}
                    <h3 class="text-xl font-bold font-[var(--font-heading)] mb-1">{exp.title}</h3>
                    <p class="text-[var(--color-primary-container)] font-bold mb-3">
                      {exp.company}
                      <span class="text-[var(--color-on-surface)]/50 font-normal"> · {exp.location}</span>
                    </p>
                    <p class="text-[var(--color-on-surface)]/70 text-sm leading-relaxed mb-4">
                      {exp.description}
                    </p>
                    {exp.achievements.length > 0 && (
                      <ul class="space-y-1 mb-4">
                        {exp.achievements.map((a) => (
                          <li class="text-sm text-[var(--color-on-surface)]/60 flex items-start gap-2">
                            <span class="text-[var(--color-primary-container)] mt-0.5 shrink-0">▸</span>
                            <span>{a}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="flex flex-wrap gap-2">
                      {exp.tech.map((t) => (
                        <span class="px-2 py-0.5 text-xs bg-[var(--color-surface-container-high)] ghost-border rounded text-[var(--color-on-surface-variant)]">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <>
                {/* Card — left side (desktop) / full width indented (mobile) */}
                <div class="ml-10 md:ml-0 md:w-1/2 md:pr-12 md:order-first">
                  {/* Period visible on mobile */}
                  <p class="md:hidden text-[var(--color-on-surface-variant)] font-bold text-sm mb-2">{exp.period}</p>
                  <div class="bg-[var(--color-surface-container)] ghost-border p-6 rounded-xl hover:border-[var(--color-primary-container)]/30 transition-all duration-300">
                    {exp.current && (
                      <span class="inline-block mb-2 px-2 py-0.5 text-xs font-bold uppercase tracking-wider bg-[var(--color-primary-container)]/10 text-[var(--color-primary-container)] rounded-full">
                        Actual
                      </span>
                    )}
                    <h3 class="text-xl font-bold font-[var(--font-heading)] mb-1">{exp.title}</h3>
                    <p class="text-[var(--color-primary-container)] font-bold mb-3">
                      {exp.company}
                      <span class="text-[var(--color-on-surface)]/50 font-normal"> · {exp.location}</span>
                    </p>
                    <p class="text-[var(--color-on-surface)]/70 text-sm leading-relaxed mb-4">
                      {exp.description}
                    </p>
                    {exp.achievements.length > 0 && (
                      <ul class="space-y-1 mb-4">
                        {exp.achievements.map((a) => (
                          <li class="text-sm text-[var(--color-on-surface)]/60 flex items-start gap-2">
                            <span class="text-[var(--color-primary-container)] mt-0.5 shrink-0">▸</span>
                            <span>{a}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                    <div class="flex flex-wrap gap-2">
                      {exp.tech.map((t) => (
                        <span class="px-2 py-0.5 text-xs bg-[var(--color-surface-container-high)] ghost-border rounded text-[var(--color-on-surface-variant)]">
                          {t}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>

                {/* Date — right side (desktop) / hidden on mobile */}
                <div class="hidden md:flex md:w-1/2 md:justify-start md:pl-12 pt-4 md:order-last">
                  <span class="text-[var(--color-on-surface-variant)] font-[var(--font-heading)] font-bold text-xl">
                    {exp.period}
                  </span>
                </div>
              </>
            )}

          </div>
        );
      })}
    </div>

  </div>
</section>
