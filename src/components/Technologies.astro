---
import Badge from './ui/Badge.astro';
import { technologyCategories } from '../data/technologies';
---

<section id="tecnologias" class="py-20 bg-(--bg-secondary)">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-12">
      <p class="font-body text-accent font-medium mb-2">Mis herramientas</p>
      <h2 class="font-heading text-3xl sm:text-4xl font-bold text-(--text-primary)">
        Stack Tecnológico
      </h2>
    </div>

    <!-- Tier Legend -->
    <div class="flex flex-wrap justify-center gap-4 mb-12">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-accent/30 border border-accent/50"></span>
        <span class="font-body text-sm text-(--text-secondary)">Expert</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-blue-500/30 border border-blue-500/50"></span>
        <span class="font-body text-sm text-(--text-secondary)">Proficient</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-(--bg-tertiary) border border-(--border)"></span>
        <span class="font-body text-sm text-(--text-secondary)">Familiar</span>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {technologyCategories.map((category, idx) => (
        <div class={`animate-on-scroll scale-in stagger-${idx + 1} bg-(--bg-primary) p-6 rounded-xl border border-(--border) hover:border-accent/50 transition-all duration-300 hover:-translate-y-1`}>
          <h3 class="font-heading text-lg font-bold text-(--text-primary) mb-4 pb-2 border-b border-(--border)">
            {category.name}
          </h3>
          <div class="flex flex-wrap gap-2">
            {category.techs.map((tech) => (
              <Badge label={tech.name} tier={tech.level} size="md" />
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
