---
import { technologyCategories } from '../data/technologies';
---

<section id="tecnologias" class="py-24 bg-[var(--color-surface-container-low)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="mb-12 animate-on-scroll fade-in-up">
      <p class="text-xs font-bold tracking-widest text-[var(--color-primary-container)] uppercase mb-3">
        STACK TÉCNICO
      </p>
      <h2 class="font-[var(--font-heading)] text-4xl sm:text-5xl font-bold text-[var(--color-on-surface)]">
        Tecnologías
      </h2>
    </div>

    <!-- Skill level legend -->
    <div class="flex flex-wrap gap-6 mb-12 animate-on-scroll fade-in-up">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[var(--color-primary-container)]"></span>
        <span class="text-xs font-bold tracking-wide text-[var(--color-on-surface-variant)] uppercase">Expert</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-slate-400"></span>
        <span class="text-xs font-bold tracking-wide text-[var(--color-on-surface-variant)] uppercase">Proficient</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-slate-600"></span>
        <span class="text-xs font-bold tracking-wide text-[var(--color-on-surface-variant)] uppercase">Familiar</span>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {technologyCategories.map((category, idx) => (
        <div class={`animate-on-scroll scale-in stagger-${idx + 1} bg-[var(--color-surface-container)] ghost-border rounded-xl p-6 hover:border-[var(--color-primary-container)]/30 transition-all duration-300`}>
          <h3 class="font-[var(--font-heading)] font-bold text-lg mb-4 text-[var(--color-on-surface)]">
            {category.name}
          </h3>
          <div class="space-y-2">
            {category.techs.map((tech) => (
              <div class="flex items-center gap-3">
                <span
                  class={`w-2.5 h-2.5 rounded-full shrink-0 ${
                    tech.level === 'Expert'
                      ? 'bg-[var(--color-primary-container)]'
                      : tech.level === 'Proficient'
                      ? 'bg-slate-400'
                      : 'bg-slate-600'
                  }`}
                ></span>
                <span class="text-sm text-[var(--color-on-surface-variant)]">
                  {tech.name}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
