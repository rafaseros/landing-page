---
import { socialLinks } from '../data/social-links';

const currentYear = new Date().getFullYear();
---

<footer class="bg-[var(--color-surface-container-lowest)] py-12 px-8">
  <!-- Gradient separator -->
  <div class="gradient-separator mb-12"></div>

  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">

      <!-- Logo left -->
      <div>
        <a href="/" class="font-[var(--font-heading)] font-bold text-[var(--color-on-surface)] uppercase tracking-tighter text-xl hover:text-[var(--color-primary)] transition-colors">
          devrafaseros
        </a>
      </div>

      <!-- Copyright center -->
      <div class="order-last md:order-none">
        <p class="text-xs text-[var(--color-on-surface-variant)] text-center">
          &copy; {currentYear} Rafael Gallegos &mdash; Todos los derechos reservados
        </p>
      </div>

      <!-- Social icons right -->
      <div class="flex items-center gap-4">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.name}
            class="text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] transition-colors w-9 h-9 flex items-center justify-center rounded-lg hover:bg-[var(--color-surface-container)] transition-all"
          >
            <Fragment set:html={link.icon} />
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>
