---
import { siteMetadata, highlights } from '../data/site';
import { socialLinks } from '../data/social-links';
---

<section id="hero" class="relative min-h-screen overflow-hidden hero-glow pt-24">
  <div class="max-w-7xl mx-auto px-8 py-16 md:py-32 flex flex-col md:flex-row items-center justify-between gap-16">

    <!-- Left: 60% -->
    <div class="w-full md:w-3/5 space-y-8">

      <!-- Overline label -->
      <span
        class="text-[var(--color-primary)] font-bold tracking-[0.1em] text-sm uppercase animate-fade-in-up opacity-0"
        style="animation-delay: 100ms; animation-fill-mode: forwards;"
      >
        TECH LEAD & SOFTWARE ARCHITECT
      </span>

      <!-- Name split -->
      <h1
        class="text-6xl md:text-8xl font-[var(--font-heading)] font-bold tracking-tight leading-[0.9] animate-fade-in-up opacity-0"
        style="animation-delay: 200ms; animation-fill-mode: forwards;"
      >
        RAFAEL<br />
        <span class="text-[var(--color-primary-container)]">GALLEGOS</span>
      </h1>

      <!-- Subtitle -->
      <p
        class="text-xl md:text-2xl text-[var(--color-on-surface-variant)] animate-fade-in-up opacity-0"
        style="animation-delay: 300ms; animation-fill-mode: forwards;"
      >
        Tech Lead · Software Architect
      </p>

      <!-- Tagline -->
      <p
        class="text-[var(--color-on-surface-variant)] text-lg leading-relaxed max-w-xl animate-fade-in-up opacity-0"
        style="animation-delay: 400ms; animation-fill-mode: forwards;"
      >
        {siteMetadata.description}
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 animate-fade-in-up opacity-0"
        style="animation-delay: 500ms; animation-fill-mode: forwards;"
      >
        <a
          href="#proyectos"
          class="inline-flex items-center justify-center bg-[var(--color-primary-container)] text-[var(--color-on-primary-container)] px-8 py-4 rounded-xl font-bold text-lg hover:shadow-[0_0_20px_rgba(220,38,38,0.4)] transition-all"
        >
          Ver Proyectos
        </a>
        <a
          href="/cv"
          class="ghost-border inline-flex items-center justify-center bg-[var(--color-surface-container-low)]/50 hover:bg-[var(--color-surface-container-high)] text-[var(--color-on-surface)] px-8 py-4 rounded-xl font-bold text-lg backdrop-blur-sm transition-all"
        >
          Descargar CV
        </a>
      </div>

      <!-- Social Links -->
      <div
        class="flex gap-4 animate-fade-in-up opacity-0"
        style="animation-delay: 600ms; animation-fill-mode: forwards;"
      >
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="p-3 rounded-lg bg-[var(--color-surface-container-low)] border border-[var(--color-outline-variant)] text-[var(--color-on-surface-variant)] hover:text-[var(--color-primary)] hover:border-[var(--color-primary)] transition-all hover:scale-110"
            aria-label={link.name}
          >
            <Fragment set:html={link.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Right: 40% Avatar -->
    <div
      class="w-full md:w-2/5 flex justify-center animate-fade-in opacity-0"
      style="animation-delay: 300ms; animation-fill-mode: forwards;"
    >
      <div class="relative group">
        <!-- Avatar container -->
        <div class="relative avatar-glow">
          <div class="w-64 h-64 md:w-96 md:h-96 rounded-full overflow-hidden border-4 border-[var(--color-surface-container-highest)] bg-gradient-to-br from-[var(--color-surface-container-high)] via-[var(--color-surface-container)] to-[var(--color-surface-container-lowest)] flex items-center justify-center">
            <span class="font-[var(--font-heading)] text-6xl md:text-8xl font-bold text-[var(--color-primary)] select-none">
              RG
            </span>

            <!-- Available badge -->
            <div class="absolute bottom-6 right-6 flex items-center gap-2 bg-[var(--color-surface-container-lowest)]/90 backdrop-blur-sm px-3 py-1.5 rounded-full border border-[var(--color-outline-variant)] shadow-lg">
              <span class="w-2.5 h-2.5 bg-green-500 rounded-full animate-pulse"></span>
              <span class="font-[var(--font-body)] text-xs text-[var(--color-on-surface-variant)] font-medium">Disponible</span>
            </div>
          </div>
        </div>

        <!-- Decorative red blur -->
        <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-[var(--color-primary-container)]/20 blur-3xl rounded-full pointer-events-none"></div>
        <!-- Decorative blue blur -->
        <div class="absolute -top-6 -left-6 w-32 h-32 bg-[var(--color-tertiary-container)]/15 blur-3xl rounded-full pointer-events-none"></div>
      </div>
    </div>
  </div>

  <!-- Stats Row -->
  <div
    class="max-w-7xl mx-auto px-8 pb-20 animate-fade-in-up opacity-0"
    style="animation-delay: 700ms; animation-fill-mode: forwards;"
  >
    <div class="glass-card grid grid-cols-2 md:grid-cols-4 py-10 px-8 rounded-[2rem]">
      {highlights.map((item, i) => (
        <div class:list={["flex flex-col gap-1", i > 0 ? "border-l border-black/10 dark:border-white/10 pl-8" : ""]}>
          <span class="text-[var(--color-primary)] font-[var(--font-heading)] font-bold text-3xl md:text-4xl">
            {item.displayValue}
          </span>
          <span class="text-[var(--color-on-surface-variant)] text-sm uppercase tracking-widest font-semibold">
            {item.label}
          </span>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg
      class="w-6 h-6 text-[var(--color-on-surface-variant)]"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"
      ></path>
    </svg>
  </div>
</section>
